// VCamES exact-build Pixel 5 global Provider. Append to
// hardware/interfaces/camera/provider/2.4/default/Android.bp.
cc_binary {
    name: "vcames-global-camera-provider",
    defaults: ["hidl_defaults"],
    proprietary: true,
    compile_multilib: "64",
    srcs: [
        "vcames-global-service.cpp",
        "ExternalCameraProviderImpl_2_4.cpp",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: [
        "android.hardware.camera.common@1.0",
        "android.hardware.camera.device@1.0",
        "android.hardware.camera.device@3.2",
        "android.hardware.camera.device@3.3",
        "android.hardware.camera.device@3.4",
        "android.hardware.camera.device@3.5",
        "android.hardware.camera.provider@2.4",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
        "camera.device@3.2-impl",
        "camera.device@3.3-impl",
        "camera.device@3.4-impl",
        "libbinder",
        "libcamera_metadata",
        "libcutils",
        "libexif",
        "libfmq",
        "libgralloctypes",
        "libhardware",
        "libhidlbase",
        "libjpeg",
        "liblog",
        "libsync",
        "libtinyxml2",
        "libui",
        "libutils",
        "libyuv",
    ],
    static_libs: [
        "android.hardware.camera.common@1.0-helper",
        "vcames-camera-device-3-4",
    ],
    header_libs: [
        "camera.device@3.4-external-impl_headers",
        "camera.device@3.4-impl_headers",
    ],
}
