{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GUSHU101/vcames/profiles/schema/profile-v1.schema.json",
  "title": "VCamES exact-build Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compatibility_id", "vendor_family", "soc_family", "api",
    "device", "build", "camera_hal", "hashes", "capabilities", "resources", "validation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "compatibility_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vendor_family": {"enum": ["google", "xiaomi"]},
    "soc_family": {"enum": ["tensor", "qualcomm", "mediatek"]},
    "api": {"type": "integer", "minimum": 30, "maximum": 33},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "product", "device", "model"],
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "region": {"type": "string"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "security_patch", "system_fingerprint_sha256", "vendor_fingerprint_sha256"],
      "properties": {
        "build_id": {"type": "string", "minLength": 1},
        "security_patch": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "system_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vendor_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "camera_hal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "provider_instance"],
      "properties": {
        "transport": {"enum": ["hidl", "aidl", "mixed"]},
        "provider_instance": {"type": "string", "minLength": 1}
      }
    },
    "hashes": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front", "back"],
      "properties": {
        "front": {"type": "boolean"},
        "back": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_proprietary_oem_files", "artifact_sha256"],
      "properties": {
        "contains_proprietary_oem_files": {"const": false},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report"],
      "properties": {
        "status": {"enum": ["CANDIDATE", "VERIFIED", "REJECTED"]},
        "report": {"type": "string", "minLength": 1}
      }
    }
  }
}
